{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "checkJs": false,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/*"],
      "@resources/*": ["build/*"]
    }
  },
  "include": ["src/renderer/**/*", "vite.config.js"],
  "exclude": ["node_modules", "dist", "release", "docs"]
}
